generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  password_hash        String?
  first_name           String
  last_name            String
  phone                String?
  email_verified       Boolean             @default(false)
  is_active            Boolean             @default(true)
  is_deleted           Boolean             @default(false)
  deleted_at           DateTime?
  role                 UserRole            @default(USER)
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  last_login_at        DateTime?
  reset_token          String?             @unique
  reset_token_expires  DateTime?
  accounts             Account[]
  audit_logs           AuditLog[]
  created_companies    Company[]           @relation("CreatedBy")
  company_members      CompanyMember[]
  expense_attachments  ExpenseAttachment[]
  expenses             Expense[]
  income               Income[]
  recurring_expenses   RecurringExpense[]
  sessions             Session[]
  assigned_tickets     SupportTicket[]     @relation("AssignedTo")
  support_tickets      SupportTicket[]
  sent_invites              TeamInvite[]        @relation("InvitedBy")
  ticket_replies            TicketReply[]
  uploaded_pending_docs     PendingDocument[]   @relation("PendingDocUploader")
  approved_pending_docs     PendingDocument[]   @relation("PendingDocApprover")

  @@index([email])
  @@index([role])
  @@index([is_deleted])
  @@map("users")
}

model Company {
  id                  String             @id @default(cuid())
  name                String
  registration_number String?
  tax_number          String?
  vat_number          String?
  business_type       String?
  address_line1       String?
  address_line2       String?
  city                String?
  province            String?
  postal_code         String?
  country             String             @default("South Africa")
  phone               String?
  email               String?
  website             String?
  fiscal_year_end     String?
  currency            String             @default("ZAR")
  logo_url            String?
  is_active           Boolean            @default(true)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  created_by_id       String
  assets              Asset[]
  created_by          User               @relation("CreatedBy", fields: [created_by_id], references: [id])
  members             CompanyMember[]
  expense_categories  ExpenseCategory[]
  expenses            Expense[]
  income              Income[]
  income_categories   IncomeCategory[]
  recurring_expenses  RecurringExpense[]
  subscription        Subscription?
  invites             TeamInvite[]
  vehicle_log_entries VehicleLogEntry[]
  pending_documents   PendingDocument[]

  @@index([created_by_id])
  @@map("companies")
}

model CompanyMember {
  id          String   @id @default(cuid())
  company_id  String
  user_id     String
  role        String
  permissions Json?
  is_active   Boolean  @default(true)
  joined_at   DateTime @default(now())
  updated_at  DateTime @updatedAt
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([company_id, user_id])
  @@index([company_id])
  @@index([user_id])
  @@map("company_members")
}

model TeamInvite {
  id          String    @id @default(cuid())
  company_id  String
  email       String
  role        String
  token       String    @unique
  invited_by  String
  expires_at  DateTime
  accepted_at DateTime?
  created_at  DateTime  @default(now())
  company     Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  inviter     User      @relation("InvitedBy", fields: [invited_by], references: [id])

  @@index([company_id])
  @@index([email])
  @@index([token])
  @@map("team_invites")
}

model ExpenseCategory {
  id                 String             @id @default(cuid())
  company_id         String?
  name               String
  color              String?
  icon               String?
  is_system          Boolean            @default(false)
  is_active          Boolean            @default(true)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  company            Company?           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  expenses           Expense[]
  recurring_expenses RecurringExpense[]

  @@index([company_id])
  @@map("expense_categories")
}

model Expense {
  id                    String              @id @default(cuid())
  company_id            String
  category_id           String
  user_id               String
  amount                Decimal             @db.Decimal(12, 2)
  currency              String              @default("ZAR")
  expense_date          DateTime
  vendor_name           String?
  description           String?
  payment_method        String?
  receipt_url           String?
  is_tax_deductible     Boolean             @default(true)
  status                String              @default("pending")
  approved_by_id        String?
  approved_at           DateTime?
  notes                 String?
  is_deleted            Boolean             @default(false)
  deleted_at            DateTime?
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt
  recurring_expense_id  String?
  charges               Decimal             @default(0) @db.Decimal(12, 2)
  deductible_percentage Int                 @default(100)
  receipt_status        String?
  amount_excl_vat       Decimal?            @db.Decimal(12, 2)
  vat_amount            Decimal?            @db.Decimal(12, 2)
  is_vat_inclusive      Boolean             @default(false)
  source_document_id    String?             // Reference to the document this expense was imported from
  attachments           ExpenseAttachment[]
  category              ExpenseCategory     @relation(fields: [category_id], references: [id])
  company               Company             @relation(fields: [company_id], references: [id], onDelete: Cascade)
  recurring_expense     RecurringExpense?   @relation(fields: [recurring_expense_id], references: [id])
  user                  User                @relation(fields: [user_id], references: [id])
  pending_documents     PendingDocument[]
  source_document       PendingDocument?    @relation("ExpenseSourceDocument", fields: [source_document_id], references: [id])

  @@index([company_id])
  @@index([category_id])
  @@index([user_id])
  @@index([expense_date])
  @@index([is_deleted])
  @@index([recurring_expense_id])
  @@index([source_document_id])
  @@map("expenses")
}

model RecurringExpense {
  id                 String          @id @default(cuid())
  company_id         String
  category_id        String
  created_by_id      String
  amount             Decimal         @db.Decimal(12, 2)
  currency           String          @default("ZAR")
  vendor_name        String?
  description        String
  payment_method     String?
  is_tax_deductible  Boolean         @default(true)
  frequency          String
  start_date         DateTime
  end_date           DateTime?
  next_occurrence    DateTime
  last_generated_at  DateTime?
  is_active          Boolean         @default(true)
  notes              String?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  generated_expenses Expense[]
  category           ExpenseCategory @relation(fields: [category_id], references: [id])
  company            Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  created_by         User            @relation(fields: [created_by_id], references: [id])

  @@index([company_id])
  @@index([is_active])
  @@index([next_occurrence])
  @@map("recurring_expenses")
}

model ExpenseAttachment {
  id          String   @id @default(cuid())
  expense_id  String
  file_name   String
  file_type   String
  file_size   Int
  file_url    String
  uploaded_by String
  created_at  DateTime @default(now())
  expense     Expense  @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [uploaded_by], references: [id])

  @@index([expense_id])
  @@map("expense_attachments")
}

model IncomeCategory {
  id         String   @id @default(cuid())
  company_id String?
  name       String
  color      String?
  icon       String?
  is_system  Boolean  @default(false)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  income     Income[]
  company    Company? @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@map("income_categories")
}

model Income {
  id                 String         @id @default(cuid())
  company_id         String
  category_id        String
  amount             Decimal        @db.Decimal(12, 2)
  currency           String         @default("ZAR")
  income_date        DateTime
  source_name        String?
  description        String?
  payment_method     String?
  invoice_number     String?
  notes              String?
  is_deleted         Boolean        @default(false)
  deleted_at         DateTime?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  user_id            String
  amount_excl_vat    Decimal?       @db.Decimal(12, 2)
  vat_amount         Decimal?       @db.Decimal(12, 2)
  is_vat_inclusive   Boolean        @default(false)
  source_document_id String?        // Reference to the document this income was imported from
  category           IncomeCategory    @relation(fields: [category_id], references: [id])
  company            Company           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [user_id], references: [id])
  pending_documents  PendingDocument[]
  source_document    PendingDocument?  @relation("IncomeSourceDocument", fields: [source_document_id], references: [id])

  @@index([company_id])
  @@index([category_id])
  @@index([user_id])
  @@index([income_date])
  @@index([is_deleted])
  @@index([source_document_id])
  @@map("income")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Asset {
  id                   String            @id @default(cuid())
  company_id           String
  name                 String
  description          String?
  asset_type           String
  purchase_date        DateTime
  purchase_cost        Decimal           @db.Decimal(12, 2)
  useful_life_years    Int
  depreciation_rate    Decimal           @db.Decimal(5, 2)
  residual_value       Decimal           @default(0) @db.Decimal(12, 2)
  business_use_percent Int               @default(100)
  disposal_date        DateTime?
  disposal_proceeds    Decimal?          @db.Decimal(12, 2)
  serial_number        String?
  notes                String?
  is_deleted           Boolean           @default(false)
  deleted_at           DateTime?
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  company              Company           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  vehicle_log_entries  VehicleLogEntry[]

  @@index([company_id])
  @@index([asset_type])
  @@index([is_deleted])
  @@map("assets")
}

model VehicleLogEntry {
  id             String   @id @default(cuid())
  company_id     String
  asset_id       String
  trip_date      DateTime
  start_location String
  end_location   String
  start_odometer Int
  end_odometer   Int
  distance_km    Int
  purpose        String
  client_name    String?
  is_business    Boolean  @default(true)
  notes          String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  asset          Asset    @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  company        Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([asset_id])
  @@index([trip_date])
  @@index([is_business])
  @@map("vehicle_log_entries")
}

model SupportTicket {
  id              String         @id @default(cuid())
  ticket_number   String         @unique
  user_id         String?
  assigned_to_id  String?
  subject         String
  description     String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  category        String?
  contact_name    String?
  contact_email   String?
  contact_company String?
  resolved_at     DateTime?
  closed_at       DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  assigned_to     User?          @relation("AssignedTo", fields: [assigned_to_id], references: [id])
  user            User?          @relation(fields: [user_id], references: [id])
  replies         TicketReply[]

  @@index([user_id])
  @@index([assigned_to_id])
  @@index([status])
  @@index([priority])
  @@index([created_at])
  @@map("support_tickets")
}

model TicketReply {
  id          String        @id @default(cuid())
  ticket_id   String
  user_id     String
  message     String
  is_internal Boolean       @default(false)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  ticket      SupportTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [user_id], references: [id])

  @@index([ticket_id])
  @@index([user_id])
  @@map("ticket_replies")
}

model AuditLog {
  id          String   @id @default(cuid())
  user_id     String?
  action      String
  entity_type String?
  entity_id   String?
  old_values  Json?
  new_values  Json?
  ip_address  String?
  user_agent  String?
  metadata    Json?
  created_at  DateTime @default(now())
  user        User?    @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([action])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

model SystemSetting {
  id         String   @id @default(cuid())
  key        String   @unique
  value      Json
  category   String
  is_public  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([category])
  @@map("system_settings")
}

model Announcement {
  id         String    @id @default(cuid())
  title      String
  content    String
  type       String    @default("info")
  target     String    @default("all")
  is_active  Boolean   @default(true)
  starts_at  DateTime  @default(now())
  expires_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([is_active])
  @@index([starts_at, expires_at])
  @@map("announcements")
}

model SubscriptionPlan {
  id            String           @id @default(cuid())
  name          String
  tier          SubscriptionTier @unique
  description   String?
  price_monthly Decimal          @db.Decimal(10, 2)
  price_yearly  Decimal          @db.Decimal(10, 2)
  features      Json
  limits        Json
  is_active     Boolean          @default(true)
  display_order Int              @default(0)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  subscriptions Subscription[]

  @@index([is_active])
  @@map("subscription_plans")
}

model Subscription {
  id                      String              @id @default(cuid())
  company_id              String              @unique
  plan_id                 String
  status                  SubscriptionStatus  @default(ACTIVE)
  billing_cycle           BillingCycle        @default(MONTHLY)
  payfast_token           String?
  payfast_subscription_id String?
  current_period_start    DateTime
  current_period_end      DateTime
  next_billing_date       DateTime?
  trial_ends_at           DateTime?
  cancelled_at            DateTime?
  cancel_at_period_end    Boolean             @default(false)
  amount                  Decimal             @db.Decimal(10, 2)
  currency                String              @default("ZAR")
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt
  payments                Payment[]
  usage_records           SubscriptionUsage[]
  company                 Company             @relation(fields: [company_id], references: [id], onDelete: Cascade)
  plan                    SubscriptionPlan    @relation(fields: [plan_id], references: [id])

  @@index([company_id])
  @@index([plan_id])
  @@index([status])
  @@index([payfast_token])
  @@index([current_period_end])
  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(cuid())
  subscription_id String
  m_payment_id    String?
  pf_payment_id   String?       @unique
  amount          Decimal       @db.Decimal(10, 2)
  fee             Decimal?      @db.Decimal(10, 2)
  net_amount      Decimal?      @db.Decimal(10, 2)
  currency        String        @default("ZAR")
  status          PaymentStatus @default(PENDING)
  payment_method  String?
  period_start    DateTime
  period_end      DateTime
  itn_payload     Json?
  paid_at         DateTime?
  failed_at       DateTime?
  failure_reason  String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  subscription    Subscription  @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([subscription_id])
  @@index([pf_payment_id])
  @@index([status])
  @@index([created_at])
  @@map("payments")
}

model SubscriptionUsage {
  id                 String       @id @default(cuid())
  subscription_id    String
  period_start       DateTime
  period_end         DateTime
  transactions_count Int          @default(0)
  api_calls_count    Int          @default(0)
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
  subscription       Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@unique([subscription_id, period_start])
  @@index([subscription_id])
  @@map("subscription_usage")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// AI Document Analysis Models
model PendingDocument {
  id                String                @id @default(cuid())
  company_id        String
  document_type     String                // INVOICE, RECEIPT, BANK_STATEMENT, PAYSLIP, EXPENSE_REPORT, OTHER
  confidence        Float
  extracted_data    Json                  // All extracted fields from AI
  original_filename String
  file_url          String                // MinIO/S3 URL
  file_size         Int
  status            PendingDocumentStatus @default(PENDING)
  uploaded_by       String
  created_at        DateTime              @default(now())
  approved_at       DateTime?
  approved_by       String?
  rejection_reason  String?
  notes             String?
  linked_expense_id String?
  linked_income_id  String?

  company               Company              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  uploader              User                 @relation("PendingDocUploader", fields: [uploaded_by], references: [id])
  approver              User?                @relation("PendingDocApprover", fields: [approved_by], references: [id])
  expense               Expense?             @relation(fields: [linked_expense_id], references: [id])
  income                Income?              @relation(fields: [linked_income_id], references: [id])
  analysis_log          DocumentAnalysisLog?
  imported_expenses     Expense[]            @relation("ExpenseSourceDocument")
  imported_income       Income[]             @relation("IncomeSourceDocument")

  @@index([company_id])
  @@index([status])
  @@index([uploaded_by])
  @@index([created_at])
  @@map("pending_documents")
}

model DocumentAnalysisLog {
  id                  String   @id @default(cuid())
  pending_document_id String   @unique
  analysis_result     Json
  confidence          Float
  tokens_used         Int
  model_used          String
  processing_time_ms  Int?
  processed_at        DateTime @default(now())

  pending_document PendingDocument @relation(fields: [pending_document_id], references: [id], onDelete: Cascade)

  @@index([pending_document_id])
  @@index([processed_at])
  @@map("document_analysis_logs")
}

enum PendingDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}
